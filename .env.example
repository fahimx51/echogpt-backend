# Server
PORT="3000"

# Optional. Reserved for CORS configuration if a frontend is added later.
FRONTEND_URL="http://localhost:5000"


# Redis, used for search result caching (e.g. Redis Cloud free tier)
REDIS_URL="redis://default:your-password@your-host:6379"

# JWT (generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-with-a-different-value"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Encrypts stored AI provider API keys. Must be 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-me"

# Web search (https://serper.dev)
SERPER_API_KEY="replace-me"

