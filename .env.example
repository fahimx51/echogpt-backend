# Database. docker compose overrides this to use the bundled Postgres.
# For a hosted database such as Neon, use the connection string from its dashboard.
# DATABASE_URL="postgresql://echogpt:echogpt@localhost:5432/echogpt?schema=public"

# JWT (generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-with-a-different-value"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Encrypts stored AI provider API keys. Must be 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-me"

# Web search (https://serper.dev)
SERPER_API_KEY="replace-me"
